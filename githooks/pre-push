#!/bin/sh
# Block direct pushes to main, except fast-lane docs-only changes; everything else reaches main by
# merging a reviewed PR. (GitHub branch protection needs GitHub Pro on private repos, so this is the
# local guard.)
. "$(dirname "$0")/fastlane.sh"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  if [ "$local_sha" = "$zero" ] || [ "$remote_sha" = "$zero" ]; then
    echo "pre-push: deleting or creating main is blocked." >&2
    exit 1
  fi
  if ! files=$(git diff --name-only --no-renames "$remote_sha...$local_sha" 2>/dev/null); then
    echo "pre-push: can't compare with the remote main; run git pull --ff-only first." >&2
    exit 1
  fi
  if ! fastlane_ok "$files"; then
    echo "pre-push: only docs-only changes (*.md outside .claude/ and .github/) may be pushed to main;" >&2
    echo "the files above need a branch and a PR." >&2
    exit 1
  fi
done
exit 0
