#!/bin/sh
# Block direct pushes to main: changes reach main only by merging a reviewed PR.
# (GitHub branch protection needs GitHub Pro on private repos, so this is the local guard.)
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked. Push a branch and open a PR." >&2
    exit 1
  fi
done
exit 0
