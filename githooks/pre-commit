#!/bin/sh
# Block commits on main, and commits that leak company data or break tests.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "pre-commit: don't commit on main. Create a branch: git checkout -b feat/<item>-<slug>" >&2
  exit 1
fi
python3 scripts/check_leaks.py --staged || exit 1
python3 -m unittest discover -q tests >/dev/null 2>&1 || {
  echo "pre-commit: tests failing. Run: python3 -m unittest discover tests" >&2
  exit 1
}
