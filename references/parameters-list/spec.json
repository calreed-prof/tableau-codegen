{
  "parameters": {
    "Metric Choice": { "type": "string", "values": ["Sales", "Profit"], "value": "Sales" }
  },
  "datasources": {
    "sales": {
      "csv": "sales.csv",
      "caption": "Sales",
      "calcs": {
        "Profit Ratio": "SUM([Profit]) / SUM([Sales])",
        "Chosen Metric": "IF [Metric Choice] = 'Sales' THEN [Sales] ELSE [Profit] END"
      }
    }
  },
  "sheets": {
    "Sales by Region": { "cols": "Region", "rows": "sum(Sales)", "color": "Category", "mark": "bar" },
    "Profit by Category": { "rows": "Category", "cols": "sum(Chosen Metric)", "mark": "bar" },
    "Ratio by Region": { "cols": "Region", "rows": "agg(Profit Ratio)", "mark": "circle" }
  },
  "dashboards": {
    "Overview": {
      "size": [1200, 800],
      "layout": [["Sales by Region", "Profit by Category"], ["Ratio by Region"]],
      "parameters": ["Metric Choice"]
    }
  }
}
